HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
UATU_BACKEND_URL=http://127.0.0.1:8080
# Generate a dedicated backend operator key of at least 32 bytes.
UATU_API_KEY=
SESSION_SECRET=
# Dedicated session database and role. It may share a PostgreSQL server with the
# backend, but never the backend's database or credentials.
SESSION_DATABASE_URL=postgres://uatu:local-only@127.0.0.1:5433/uatu_sessions?sslmode=disable
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated exact OIDC subject identifiers authorized to use this deployment.
OIDC_ALLOWED_SUBJECTS=
# Optional subset of allowed subjects permitted to add tracked employees. Empty disables onboarding.
OIDC_ADMIN_SUBJECTS=
# Enable only behind one trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
